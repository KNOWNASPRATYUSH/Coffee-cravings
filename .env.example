# Vercel -> Project -> Settings -> Environment Variables (Production)
SESSION_SECRET=            # random, 32+ characters (openssl rand -base64 48)
OWNER_PIN=                 # 6-12 digits, only you. Unlocks QR codes + orders
BARISTA_PIN=               # 6-12 digits, share with baristas. Orders only
# Add the Upstash Redis integration from Vercel Marketplace; it injects these automatically:
# KV_REST_API_URL / KV_REST_API_TOKEN   (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# --- Online payments (optional, add later). Without these the site uses Pay-at-Counter / barista-confirmed UPI ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # you choose it; same value in Razorpay Dashboard -> Webhooks
