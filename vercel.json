{
  "rewrites": [
    { "source": "/staff", "destination": "/staff/index.html" },
    { "source": "/staff/", "destination": "/staff/index.html" },
    { "source": "/order", "destination": "/index.html" },
    { "source": "/order/", "destination": "/index.html" },
    { "source": "/story", "destination": "/index.html" },
    { "source": "/story/", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/gallery/", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact/", "destination": "/index.html" },
    { "source": "/my-orders", "destination": "/index.html" },
    { "source": "/my-orders/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/staff", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" }
    ]},
    { "source": "/staff/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" }
    ]}
  ]
}
